/* ==========================================================================
   SKA Gebäudeservice — Design System
   ========================================================================== */

:root{
  /* Farben */
  --navy-900:#08191F;
  --navy-800:#0B2027;
  --navy-700:#12313B;
  /* Markengold aus dem Logo */
  --brand-700:#8F6210;   /* Text/Links auf Hell — 5.1:1 gegen Weiß */
  --brand-600:#A97518;   /* Icons, dekorative Häkchen */
  --brand-500:#D9A441;   /* Logo-Gold: Buttonfläche, Akzente */
  --brand-400:#E5B95F;   /* Gold auf dunklem Grund — 7.5:1 gegen Navy */
  --brand-100:#F1E1BE;
  --brand-050:#FDF7EA;
  --accent:#E5B95F;
  --accent-100:#FDF4E2;

  --ink:#0F1E24;
  --body:#3E5259;
  --muted:#6B7F86;
  --line:#DFE7E5;
  --line-soft:#EDF2F1;
  --bg:#FFFFFF;
  --bg-soft:#F5F8F7;
  --white:#fff;

  /* Typo */
  --font-head:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --font-body:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;

  /* Maße */
  --wrap:1180px;
  --r-sm:8px; --r-md:14px; --r-lg:20px; --r-xl:28px;
  --shadow-sm:0 1px 2px rgba(11,32,39,.06),0 2px 8px rgba(11,32,39,.05);
  --shadow-md:0 4px 12px rgba(11,32,39,.07),0 12px 32px rgba(11,32,39,.07);
  --shadow-lg:0 18px 50px rgba(11,32,39,.14);
  --ring:0 0 0 3px rgba(217,164,65,.55);
}

*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  margin:0;font-family:var(--font-body);color:var(--body);background:var(--bg);
  font-size:17px;line-height:1.65;-webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img{max-width:100%;height:auto;display:block}
a{color:var(--brand-700);text-decoration:none}
a:hover{text-decoration:underline}
h1,h2,h3,h4{font-family:var(--font-head);color:var(--ink);margin:0 0 .5em;line-height:1.15;letter-spacing:-.02em;font-weight:800}
h1{font-size:clamp(2.1rem,5vw,3.4rem)}
h2{font-size:clamp(1.7rem,3.4vw,2.5rem)}
h3{font-size:clamp(1.12rem,1.8vw,1.35rem);font-weight:700}
p{margin:0 0 1.1em}
ul{margin:0 0 1.1em;padding-left:1.2em}
li{margin-bottom:.4em}
:focus-visible{outline:none;box-shadow:var(--ring);border-radius:4px}

.wrap{width:100%;max-width:var(--wrap);margin-inline:auto;padding-inline:22px}
.section{padding:clamp(58px,8vw,104px) 0}
.section--soft{background:var(--bg-soft)}
.section--dark{background:var(--navy-800);color:#C6D6DA}
.section--dark h2,.section--dark h3{color:#fff}
.center{text-align:center}
.lead{font-size:clamp(1.05rem,1.6vw,1.22rem);color:var(--body)}
.narrow{max-width:720px;margin-inline:auto}

/* Eyebrow */
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;font-family:var(--font-head);
  font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  color:var(--brand-700);margin-bottom:14px;
}
.eyebrow::before{content:"";width:26px;height:2px;background:var(--brand-500);border-radius:2px}
.section--dark .eyebrow{color:var(--brand-400)}
.section--dark .eyebrow::before{background:var(--brand-400)}

/* ---------- Buttons ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  font-family:var(--font-head);font-weight:700;font-size:1rem;
  padding:15px 26px;border-radius:var(--r-md);border:2px solid transparent;
  cursor:pointer;transition:.18s ease;text-align:center;line-height:1.2;
}
.btn:hover{text-decoration:none;transform:translateY(-2px)}
.btn--primary{background:var(--brand-500);color:var(--navy-900);box-shadow:0 6px 18px rgba(217,164,65,.35)}
.btn--primary:hover{background:#C68C1F;box-shadow:0 10px 26px rgba(217,164,65,.45)}
.btn--ghost{background:transparent;color:var(--ink);border-color:var(--line)}
.btn--ghost:hover{border-color:var(--brand-500);color:var(--brand-700);background:var(--brand-050)}
.btn--light{background:#fff;color:var(--brand-700)}
.btn--onDark{background:transparent;color:#fff;border-color:rgba(255,255,255,.4)}
.btn--onDark:hover{background:rgba(255,255,255,.1);border-color:#fff}
.btn--lg{padding:18px 32px;font-size:1.06rem}
.btn--block{width:100%}
.btn svg{flex:0 0 auto}
.btn-row{display:flex;flex-wrap:wrap;gap:14px}
.btn-note{font-size:.9rem;color:var(--muted);margin-top:14px}
.btn-note strong{color:var(--ink)}

/* ---------- Header ---------- */
.header{position:sticky;top:0;z-index:60;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--line-soft)}
.header__bar{display:flex;align-items:center;gap:24px;height:78px}
.logo{display:flex;align-items:center;gap:11px;font-family:var(--font-head);font-weight:800;color:var(--ink);font-size:1.16rem;letter-spacing:-.02em}
.logo:hover{text-decoration:none}
.logo__mark{width:auto;height:42px;flex:0 0 auto}
.logo__sub{display:block;font-size:.66rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--brand-600);margin-top:1px}
.nav{margin-left:auto;display:flex;align-items:center;gap:4px}
.nav a{
  font-family:var(--font-head);font-weight:600;font-size:.97rem;color:var(--navy-700);
  padding:10px 12px;border-radius:var(--r-sm);transition:.15s;
}
.nav a:hover{background:var(--brand-050);color:var(--brand-700);text-decoration:none}
.nav a.is-active{color:var(--brand-700);background:var(--brand-050)}
.header__cta{display:flex;align-items:center;gap:12px;margin-left:12px}
.header__tel{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-head);font-weight:700;color:var(--ink);white-space:nowrap}
.header__tel:hover{color:var(--brand-700);text-decoration:none}
.burger{display:none;margin-left:auto;width:46px;height:46px;border:1px solid var(--line);background:#fff;border-radius:var(--r-sm);cursor:pointer;align-items:center;justify-content:center}
.burger span{display:block;width:20px;height:2px;background:var(--ink);position:relative}
.burger span::before,.burger span::after{content:"";position:absolute;left:0;width:20px;height:2px;background:var(--ink);transition:.2s}
.burger span::before{top:-6px}.burger span::after{top:6px}
.burger[aria-expanded="true"] span{background:transparent}
.burger[aria-expanded="true"] span::before{top:0;transform:rotate(45deg)}
.burger[aria-expanded="true"] span::after{top:0;transform:rotate(-45deg)}

@media(max-width:1040px){
  .nav{
    position:fixed;inset:78px 0 auto 0;background:#fff;flex-direction:column;
    align-items:stretch;gap:0;padding:14px 22px 26px;border-bottom:1px solid var(--line);
    box-shadow:var(--shadow-md);transform:translateY(-8px);opacity:0;pointer-events:none;transition:.18s;
  }
  .nav.is-open{transform:none;opacity:1;pointer-events:auto}
  .nav a{padding:14px 12px;font-size:1.05rem;border-bottom:1px solid var(--line-soft)}
  .header__cta{margin:14px 0 0;flex-direction:column;align-items:stretch}
  .header__cta .btn{width:100%}
  .burger{display:flex}
}

/* ---------- Hero ---------- */
.hero{position:relative;background:var(--navy-800);color:#C9D9DD;overflow:hidden}
.hero::before{
  content:"";position:absolute;inset:0;
  background:
    radial-gradient(900px 460px at 78% 12%,rgba(217,164,65,.26),transparent 62%),
    radial-gradient(600px 380px at 6% 92%,rgba(217,164,65,.10),transparent 60%);
}
.hero__grid{
  position:absolute;inset:0;opacity:.25;
  background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);
  background-size:56px 56px;
  -webkit-mask-image:radial-gradient(70% 70% at 50% 30%,#000,transparent);
          mask-image:radial-gradient(70% 70% at 50% 30%,#000,transparent);
}
.hero__inner{position:relative;display:grid;grid-template-columns:1.06fr .94fr;gap:56px;align-items:center;padding-block:clamp(56px,7vw,96px) clamp(64px,7vw,100px)}
.hero h1{color:#fff}
.hero h1 em{font-style:normal;color:var(--brand-400);background:linear-gradient(180deg,transparent 64%,rgba(217,164,65,.22) 64%)}
.hero__sub{font-size:clamp(1.05rem,1.7vw,1.24rem);color:#B7CBD0;max-width:44ch}
.badge-row{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:22px}
.badge{
  display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.16);color:#DCE8EA;padding:7px 13px;border-radius:999px;
  font-size:.83rem;font-weight:600;font-family:var(--font-head);
}
.badge svg{color:var(--brand-400)}
.hero__trust{display:flex;flex-wrap:wrap;gap:26px;margin-top:34px;padding-top:26px;border-top:1px solid rgba(255,255,255,.12)}
.hero__trust div{min-width:120px}
.hero__trust b{display:block;font-family:var(--font-head);font-size:1.45rem;color:#fff;line-height:1.1}
.hero__trust span{font-size:.86rem;color:#8FA8AF}

/* Hero-Karte (Angebotsformular) */
.quote-card{background:#fff;border-radius:var(--r-xl);padding:30px;box-shadow:var(--shadow-lg);color:var(--body)}
.quote-card h2{font-size:1.4rem;margin-bottom:6px}
.quote-card__hint{font-size:.92rem;color:var(--muted);margin-bottom:20px}

@media(max-width:940px){
  .hero__inner{grid-template-columns:1fr;gap:38px}
  .hero__sub{max-width:none}
}

/* ---------- Formular ---------- */
.field{margin-bottom:15px}
.field label{display:block;font-family:var(--font-head);font-weight:600;font-size:.9rem;color:var(--ink);margin-bottom:6px}
.field .req{color:#C0392B}
.field input,.field select,.field textarea{
  width:100%;padding:13px 14px;border:1.5px solid var(--line);border-radius:var(--r-sm);
  font-family:var(--font-body);font-size:1rem;color:var(--ink);background:#fff;transition:.15s;
}
.field textarea{min-height:104px;resize:vertical}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--brand-500);box-shadow:var(--ring);outline:none}
.field input:user-invalid{border-color:#C0392B}
.field--row{display:grid;grid-template-columns:1fr 1fr;gap:15px}
@media(max-width:520px){.field--row{grid-template-columns:1fr}}
.check{display:flex;gap:10px;align-items:flex-start;font-size:.85rem;color:var(--muted);margin:4px 0 18px}
.check input{width:18px;height:18px;flex:0 0 auto;margin-top:2px;accent-color:var(--brand-600)}
.form-status{display:none;margin-top:14px;padding:13px 15px;border-radius:var(--r-sm);font-size:.93rem}
.form-status.is-ok{display:block;background:var(--brand-050);border:1px solid var(--brand-100);color:var(--brand-700)}
.form-status.is-err{display:block;background:#FDECEA;border:1px solid #F5C6C2;color:#A03027}

/* ---------- Cards / Leistungen ---------- */
.grid{display:grid;gap:22px}
.grid--3{grid-template-columns:repeat(3,1fr)}
.grid--2{grid-template-columns:repeat(2,1fr)}
.grid--4{grid-template-columns:repeat(4,1fr)}
@media(max-width:940px){.grid--3,.grid--4{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.grid--2,.grid--3,.grid--4{grid-template-columns:1fr}}

.card{
  background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:28px;
  transition:.2s ease;height:100%;display:flex;flex-direction:column;
}
.card:hover{border-color:var(--brand-100);box-shadow:var(--shadow-md);transform:translateY(-3px)}
.card__icon{
  width:52px;height:52px;border-radius:14px;background:var(--brand-050);color:var(--brand-600);
  display:flex;align-items:center;justify-content:center;margin-bottom:18px;border:1px solid var(--brand-100);
}
.card h3{margin-bottom:8px}
.card p{font-size:.97rem;margin-bottom:14px}
.card ul{font-size:.93rem;color:var(--muted);padding-left:0;list-style:none;margin-bottom:16px}
.card ul li{position:relative;padding-left:22px}
.card ul li::before{
  content:"";position:absolute;left:0;top:.55em;width:11px;height:7px;
  border-left:2px solid var(--brand-600);border-bottom:2px solid var(--brand-600);transform:rotate(-45deg);
}
.card__link{margin-top:auto;font-family:var(--font-head);font-weight:700;font-size:.94rem;display:inline-flex;align-items:center;gap:6px}
.card__link:hover{gap:10px;text-decoration:none}

/* Checkliste allgemein */
.ticks{list-style:none;padding:0}
.ticks li{position:relative;padding-left:30px;margin-bottom:11px}
.ticks li::before{
  content:"";position:absolute;left:0;top:2px;width:20px;height:20px;border-radius:50%;
  background:var(--brand-050);border:1px solid var(--brand-100);
}
.ticks li::after{
  content:"";position:absolute;left:6px;top:8px;width:8px;height:5px;
  border-left:2px solid var(--brand-600);border-bottom:2px solid var(--brand-600);transform:rotate(-45deg);
}
.section--dark .ticks li::before{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.18)}
.section--dark .ticks li::after{border-color:var(--brand-400)}

/* ---------- Ablauf (Steps) ---------- */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;counter-reset:s;position:relative}
@media(max-width:800px){.steps{grid-template-columns:1fr}}
.step{position:relative;padding-top:8px}
.step__no{
  width:52px;height:52px;border-radius:50%;background:var(--brand-500);color:var(--navy-900);
  font-family:var(--font-head);font-weight:800;font-size:1.25rem;
  display:flex;align-items:center;justify-content:center;margin-bottom:18px;
  box-shadow:0 0 0 6px var(--brand-050);
}
.section--dark .step__no{box-shadow:0 0 0 6px rgba(255,255,255,.06)}
.step h3{margin-bottom:6px}
.step p{font-size:.97rem;margin:0}

/* ---------- Split ---------- */
.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,64px);align-items:center}
@media(max-width:880px){.split{grid-template-columns:1fr}}
.split--reverse .split__media{order:2}
@media(max-width:880px){.split--reverse .split__media{order:0}}

/* Bild-Platzhalter */
.ph{
  position:relative;border-radius:var(--r-lg);overflow:hidden;background:
    linear-gradient(135deg,var(--brand-050),#F4E8CE);
  border:1px solid var(--brand-100);aspect-ratio:4/3;
  display:flex;align-items:center;justify-content:center;
}
.ph::after{
  content:"";position:absolute;inset:0;opacity:.5;
  background-image:repeating-linear-gradient(45deg,rgba(169,117,24,.09) 0 10px,transparent 10px 20px);
}
.ph span{
  position:relative;z-index:1;font-family:var(--font-head);font-weight:700;font-size:.83rem;
  letter-spacing:.08em;text-transform:uppercase;color:var(--brand-700);
  background:rgba(255,255,255,.85);padding:9px 15px;border-radius:999px;border:1px solid var(--brand-100);
}
.ph--tall{aspect-ratio:3/4}
.ph--wide{aspect-ratio:16/9}

/* ---------- Region / Chips ---------- */
.chips{display:flex;flex-wrap:wrap;gap:10px;list-style:none;padding:0}
.chips li{
  background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 17px;
  font-family:var(--font-head);font-weight:600;font-size:.92rem;color:var(--navy-700);
}
.section--dark .chips li{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.15);color:#DCE8EA}

/* ---------- Zielgruppen ---------- */
.audience{background:#fff;border:1px solid var(--line);border-left:4px solid var(--brand-500);border-radius:var(--r-md);padding:24px 26px}
.audience h3{margin-bottom:6px}
.audience p{font-size:.96rem;margin:0}

/* ---------- FAQ ---------- */
.faq{max-width:820px;margin-inline:auto}
.faq details{background:#fff;border:1px solid var(--line);border-radius:var(--r-md);margin-bottom:12px;overflow:hidden;transition:.2s}
.faq details[open]{border-color:var(--brand-100);box-shadow:var(--shadow-sm)}
.faq summary{
  cursor:pointer;list-style:none;padding:20px 56px 20px 24px;position:relative;
  font-family:var(--font-head);font-weight:700;color:var(--ink);font-size:1.03rem;
}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{
  content:"";position:absolute;right:24px;top:26px;width:10px;height:10px;
  border-right:2px solid var(--brand-600);border-bottom:2px solid var(--brand-600);
  transform:rotate(45deg);transition:.2s;
}
.faq details[open] summary::after{transform:rotate(-135deg);top:29px}
.faq .faq__a{padding:0 24px 22px;font-size:.98rem}
.faq .faq__a p:last-child{margin-bottom:0}

/* ---------- CTA-Band ---------- */
.cta-band{background:linear-gradient(125deg,var(--navy-700),var(--navy-900));color:#C6D6DA;border-radius:var(--r-xl);padding:clamp(34px,5vw,58px);text-align:center;position:relative;overflow:hidden;border:1px solid rgba(217,164,65,.28)}
.cta-band::before{content:"";position:absolute;inset:0;background:radial-gradient(700px 320px at 80% 0%,rgba(217,164,65,.24),transparent 62%)}
.cta-band>*{position:relative}
.cta-band h2{color:#fff}
.cta-band p{color:#B7CBD0;max-width:56ch;margin-inline:auto}
.cta-band .btn-row{justify-content:center}

/* ---------- Kontaktinfos ---------- */
.info-list{list-style:none;padding:0;margin:0}
.info-list li{display:flex;gap:16px;padding:16px 0;border-bottom:1px solid var(--line-soft)}
.info-list li:last-child{border-bottom:none}
.info-list .ico{
  flex:0 0 auto;width:42px;height:42px;border-radius:12px;background:var(--brand-050);
  color:var(--brand-600);display:flex;align-items:center;justify-content:center;border:1px solid var(--brand-100);
}
.info-list b{display:block;font-family:var(--font-head);color:var(--ink);font-size:.95rem}
.info-list span{font-size:.97rem}
.hours{width:100%;border-collapse:collapse;font-size:.97rem}
.hours th,.hours td{text-align:left;padding:9px 0;border-bottom:1px solid var(--line-soft);font-weight:400}
.hours th{font-family:var(--font-head);font-weight:600;color:var(--ink)}
.hours td{text-align:right;color:var(--body)}
.hours tr:last-child th,.hours tr:last-child td{border-bottom:none}
.hours .closed{color:var(--muted)}

/* ---------- Footer ---------- */
.footer{background:var(--navy-900);color:#8FA8AF;padding:64px 0 0;font-size:.95rem}
.footer h4{font-family:var(--font-head);color:#fff;font-size:.86rem;letter-spacing:.12em;text-transform:uppercase;margin-bottom:16px}
.footer a{color:#B7CBD0}
.footer a:hover{color:#fff}
.footer__grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.1fr;gap:36px;padding-bottom:44px}
@media(max-width:900px){.footer__grid{grid-template-columns:1fr 1fr;gap:30px}}
@media(max-width:560px){.footer__grid{grid-template-columns:1fr}}
.footer ul{list-style:none;padding:0;margin:0}
.footer li{margin-bottom:9px}
.footer .logo{color:#fff}
.footer__bottom{border-top:1px solid rgba(255,255,255,.1);padding:22px 0 30px;display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;font-size:.88rem}
.footer__bottom a{margin-right:18px}

/* ---------- Sticky Mobile CTA ---------- */
.sticky-cta{
  position:fixed;left:0;right:0;bottom:0;z-index:70;display:none;gap:10px;padding:10px 14px;
  background:rgba(255,255,255,.96);backdrop-filter:blur(10px);border-top:1px solid var(--line);
}
.sticky-cta .btn{flex:1;padding:14px 10px;font-size:.95rem}
@media(max-width:760px){
  .sticky-cta{display:flex}
  body{padding-bottom:72px}
}

/* ---------- Utilities ---------- */
.mb-0{margin-bottom:0}
.mt-24{margin-top:24px}
.mt-40{margin-top:40px}
.skip{position:absolute;left:-9999px}
.skip:focus{left:16px;top:16px;z-index:100;background:#fff;padding:12px 18px;border-radius:8px;box-shadow:var(--shadow-md)}
.reveal{opacity:0;transform:translateY(18px)}
.reveal.is-in{opacity:1;transform:none;transition:opacity .6s ease,transform .6s ease}
@media(prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important;scroll-behavior:auto!important}
  .reveal{opacity:1;transform:none}
}

/* Page-Header (Unterseiten) */
.pagehead{background:var(--navy-800);color:#B7CBD0;position:relative;overflow:hidden;padding:clamp(46px,6vw,78px) 0}
.pagehead::before{content:"";position:absolute;inset:0;background:radial-gradient(760px 340px at 82% 10%,rgba(217,164,65,.22),transparent 62%)}
.pagehead>*{position:relative}
.pagehead h1{color:#fff;margin-bottom:12px}
.pagehead p{max-width:62ch;margin-bottom:0}
.crumbs{font-size:.86rem;color:#8FA8AF;margin-bottom:16px}
.crumbs a{color:#B7CBD0}

/* Prosa (Impressum/Datenschutz) */
.prose{max-width:820px}
.prose h2{font-size:1.5rem;margin-top:2em}
.prose h3{margin-top:1.6em}
.prose p,.prose li{font-size:1rem}
.note{background:#EDF2F4;border:1px solid #D3E0E4;border-left:4px solid var(--navy-700);border-radius:var(--r-md);padding:16px 20px;font-size:.94rem;color:var(--navy-800)}
.note strong{color:var(--navy-900)}

/* --- Logo: kein Umbruch auf schmalen Viewports --- */
.logo>span{white-space:nowrap}
@media(max-width:760px){
  .logo{font-size:1.02rem;gap:9px}
  .logo__mark{height:34px}
  .logo__sub{font-size:.58rem;letter-spacing:.1em}
}
@media(max-width:380px){
  .logo{font-size:.94rem}
  .logo__sub{display:none}
}

/* --- Lange deutsche Komposita nicht überlaufen lassen --- */
h1,h2,h3,h4,p,li,summary,label,td,th{overflow-wrap:break-word;-webkit-hyphens:auto;hyphens:auto}
.split>*,.grid>*,.steps>*,.footer__grid>*,.hero__inner>*{min-width:0}
.wrap{overflow-wrap:break-word}
.hero h1,.pagehead h1{-webkit-hyphens:manual;hyphens:manual}

/* Header-CTA: Button-Farben dürfen nicht von .nav a überschrieben werden */
.nav a.btn--primary,.nav a.btn--primary:hover{color:var(--navy-900);background:var(--brand-500)}
.nav a.btn--primary:hover{background:#C68C1F}
.nav a.btn{border-radius:var(--r-md)}
.nav a.header__tel:hover{background:transparent;color:var(--brand-700)}

/* ==========================================================================
   WhatsApp-Direktkontakt
   ========================================================================== */
:root{--wa:#25D366;--wa-dark:#1BA94F}

.wa{position:fixed;right:20px;bottom:24px;z-index:80;display:flex;flex-direction:column;align-items:flex-end;gap:14px}

/* --- Schaltfläche --- */
.wa__fab{
  position:relative;width:60px;height:60px;border-radius:50%;border:none;cursor:pointer;
  background:var(--wa);color:#fff;display:flex;align-items:center;justify-content:center;
  box-shadow:0 6px 18px rgba(11,32,39,.22),0 2px 6px rgba(11,32,39,.16);
  transition:transform .18s ease,background .18s ease,box-shadow .18s ease;
}
.wa__fab:hover{background:var(--wa-dark);transform:translateY(-2px);box-shadow:0 12px 28px rgba(11,32,39,.28)}
.wa__fab:focus-visible{outline:none;box-shadow:0 0 0 4px rgba(37,211,102,.45),0 6px 18px rgba(11,32,39,.22)}
.wa__x{display:none}
.wa__fab[aria-expanded="true"] .wa__icon{display:none}
.wa__fab[aria-expanded="true"] .wa__x{display:block}
.wa__fab[aria-expanded="true"]{background:var(--navy-800)}

/* Sprechblase am Desktop */
.wa__bubble{
  position:absolute;right:calc(100% + 12px);top:50%;transform:translateY(-50%) translateX(6px);
  background:var(--navy-800);color:#fff;font-family:var(--font-head);font-weight:600;font-size:.85rem;
  padding:8px 13px;border-radius:9px;white-space:nowrap;opacity:0;pointer-events:none;transition:.18s ease;
  box-shadow:var(--shadow-sm);
}
.wa__bubble::after{content:"";position:absolute;left:100%;top:50%;transform:translateY(-50%);
  border:6px solid transparent;border-left-color:var(--navy-800)}
.wa__fab:hover .wa__bubble,.wa__fab:focus-visible .wa__bubble{opacity:1;transform:translateY(-50%)}
.wa__fab[aria-expanded="true"] .wa__bubble{display:none}

/* --- Panel --- */
.wa__panel{
  width:min(330px,calc(100vw - 40px));background:#fff;border:1px solid var(--line);
  border-radius:var(--r-lg);box-shadow:var(--shadow-lg);overflow:hidden;
  transform-origin:bottom right;animation:waIn .18s ease-out;
  /* Passt sich jeder Bildschirmhöhe an — die Liste scrollt, der Rest bleibt sichtbar */
  display:flex;flex-direction:column;
  max-height:calc(100vh - 170px);
  max-height:calc(100dvh - 170px);
}
.wa__head,.wa__intro,.wa__note{flex:0 0 auto}
@keyframes waIn{from{opacity:0;transform:translateY(10px) scale(.97)}to{opacity:1;transform:none}}
.wa__panel[hidden]{display:none}

.wa__head{display:flex;align-items:center;gap:11px;padding:14px 16px;background:var(--wa);color:#fff}
.wa__avatar{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.22);
  display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.wa__head>span:nth-child(2){min-width:0}
.wa__head b{display:block;font-family:var(--font-head);font-size:.98rem;line-height:1.25}
.wa__status{display:block;font-size:.77rem;line-height:1.35;opacity:.92}
.wa__close{margin-left:auto;width:30px;height:30px;border-radius:50%;border:none;cursor:pointer;
  background:rgba(255,255,255,.18);color:#fff;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.wa__close:hover{background:rgba(255,255,255,.3)}
.wa__close:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(255,255,255,.6)}

.wa__intro{font-size:.87rem;color:var(--muted);margin:0;padding:14px 16px 4px}

.wa__list{display:flex;flex-direction:column;gap:7px;padding:8px 12px 4px;flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain}
.wa__opt{
  text-align:left;background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--r-sm);
  padding:11px 13px;cursor:pointer;font-family:var(--font-body);transition:.15s;
}
.wa__opt:hover{background:var(--brand-050);border-color:var(--brand-100)}
.wa__opt:focus-visible{outline:none;box-shadow:var(--ring)}
.wa__opt span{display:block;font-family:var(--font-head);font-weight:700;font-size:.94rem;color:var(--ink)}
.wa__opt small{display:block;font-size:.8rem;color:var(--muted);margin-top:1px}
.wa__opt--plain span{font-weight:600;color:var(--brand-700)}

.wa__note{font-size:.78rem;color:var(--muted);margin:0;padding:10px 16px 15px;border-top:1px solid var(--line-soft)}

/* --- Mobil: über der festen Aktionsleiste --- */
@media(max-width:760px){
  .wa{right:14px;bottom:84px;gap:12px}
  .wa__fab{width:56px;height:56px}
  .wa__bubble{display:none}
  .wa__panel{max-height:calc(100vh - 172px);max-height:calc(100dvh - 172px)}
  .wa__intro{padding-top:12px;font-size:.84rem}
  .wa__opt{padding:9px 12px}
}
@media(prefers-reduced-motion:reduce){
  .wa__panel{animation:none}
  .wa__fab:hover{transform:none}
}
.wa__panel:focus{outline:none}
.wa__panel:focus-visible{box-shadow:var(--shadow-lg),var(--ring)}

/* ==========================================================================
   Satzungstabelle (Kehrwoche)
   ========================================================================== */
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.tablewrap{overflow-x:auto;border:1px solid rgba(255,255,255,.14);border-radius:var(--r-lg);background:rgba(255,255,255,.04)}
.rules{border-collapse:collapse;width:100%;min-width:520px;font-size:.97rem}
.rules th,.rules td{text-align:left;padding:14px 20px;border-bottom:1px solid rgba(255,255,255,.09);vertical-align:top}
.rules tr:last-child th,.rules tr:last-child td{border-bottom:none}
.rules th{font-family:var(--font-head);font-weight:600;color:#fff;width:38%;font-size:.95rem}
.rules td{color:#C6D6DA}
.rules td strong{color:var(--brand-400)}
.rules__ref{
  display:inline-block;margin-left:8px;font-family:var(--font-head);font-size:.74rem;font-weight:600;
  color:#8FA8AF;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);
  padding:2px 7px;border-radius:5px;white-space:nowrap;vertical-align:1px;
}
@media(max-width:600px){
  .rules th{width:42%}
  .rules th,.rules td{padding:12px 14px;font-size:.9rem}
}
/* Hinweiskasten auf dunklem Grund */
.section--dark .note{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14);border-left-color:var(--brand-400);color:#C6D6DA}
.section--dark .note strong{color:#fff}

/* --- Kopfzeile mit fünf Navigationspunkten --- */
.nav a{white-space:nowrap}
/* Im schmalen Desktop-Band weicht die Telefonnummer, der CTA-Button bleibt */
@media(max-width:1220px) and (min-width:1041px){
  .header__tel{display:none}
  .nav a{padding-inline:11px}
}

/* ==========================================================================
   Winterdienst-Seite
   ========================================================================== */
/* Saisonhinweis */
.season{
  display:flex;flex-wrap:wrap;align-items:center;gap:14px 22px;
  background:var(--brand-050);border:1px solid var(--brand-100);border-left:4px solid var(--brand-500);
  border-radius:var(--r-md);padding:16px 22px;
}
.season__badge{
  font-family:var(--font-head);font-weight:800;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;
  background:var(--brand-500);color:var(--navy-900);padding:5px 11px;border-radius:5px;white-space:nowrap;
}
.season p{margin:0;font-size:.97rem;color:var(--ink);flex:1 1 320px}
.season .btn{flex:0 0 auto}

/* Einsatzfenster */
.times{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
@media(max-width:820px){.times{grid-template-columns:repeat(2,1fr)}}
@media(max-width:460px){.times{grid-template-columns:1fr}}
.time{
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.14);
  border-radius:var(--r-md);padding:20px 18px;display:flex;flex-direction:column;gap:4px;
}
.time--end{background:rgba(217,164,65,.10);border-color:rgba(217,164,65,.32)}
.time__day{font-family:var(--font-head);font-weight:600;font-size:.87rem;color:#8FA8AF;letter-spacing:.04em}
.time__h{font-family:var(--font-head);font-weight:800;font-size:1.85rem;color:var(--brand-400);line-height:1.1;font-variant-numeric:tabular-nums}
.time__note{font-size:.85rem;color:#B7CBD0}

/* Helle Tabellenvariante */
.tablewrap--light{border-color:var(--line);background:#fff}
.rules--light th,.rules--light td{border-bottom-color:var(--line-soft)}
.rules--light th{color:var(--ink)}
.rules--light td{color:var(--body)}
.rules--light td strong{color:var(--brand-700)}
.rules--light .rules__ref{color:var(--muted);background:var(--bg-soft);border-color:var(--line)}

/* Vertragsmodelle */
.models{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:760px){.models{grid-template-columns:1fr}}
.model{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:26px;display:flex;flex-direction:column;gap:14px;height:100%}
.model--lead{border-color:var(--brand-100);box-shadow:var(--shadow-md);position:relative}
.model__flag{
  position:absolute;top:-11px;left:24px;font-family:var(--font-head);font-weight:700;font-size:.7rem;
  letter-spacing:.1em;text-transform:uppercase;background:var(--brand-500);color:var(--navy-900);
  padding:4px 10px;border-radius:4px;
}
.model h3{margin:0}
.model__for{font-size:.9rem;color:var(--muted);margin:0}
.model ul{margin:0}
.model .ticks li{font-size:.94rem}
.model__catch{
  margin-top:auto;font-size:.88rem;color:var(--body);background:var(--bg-soft);
  border-radius:var(--r-sm);padding:11px 14px;border:1px solid var(--line-soft);
}
.model__catch b{color:var(--ink)}

/* Saisonkalender */
.cal{list-style:none;padding:0;margin:0;display:flex;flex-direction:column}
.cal li{display:grid;grid-template-columns:130px 1fr;gap:20px;padding:16px 0;border-bottom:1px solid var(--line-soft)}
.cal li:last-child{border-bottom:none}
.cal time{
  font-family:var(--font-head);font-weight:700;font-size:.93rem;color:var(--brand-700);
  letter-spacing:.02em;padding-top:1px;
}
.cal b{display:block;font-family:var(--font-head);color:var(--ink);font-size:1rem;margin-bottom:2px}
.cal p{margin:0;font-size:.94rem}
@media(max-width:560px){.cal li{grid-template-columns:1fr;gap:4px}}

/* ==========================================================================
   Seite für Hausverwaltungen
   ========================================================================== */
/* Umlagefähigkeits-Tabelle */
.umlage{border-collapse:collapse;width:100%;min-width:600px;font-size:.95rem;background:#fff}
.umlage th,.umlage td{text-align:left;padding:13px 18px;border-bottom:1px solid var(--line-soft);vertical-align:middle}
.umlage thead th{
  font-family:var(--font-head);font-size:.74rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;
  color:var(--muted);background:var(--bg-soft);border-bottom:1px solid var(--line);
}
.umlage tbody tr:last-child td,.umlage tbody tr:last-child th{border-bottom:none}
.umlage tbody th{font-family:var(--font-head);font-weight:600;color:var(--ink);width:44%}
.umlage td:last-child{text-align:right;white-space:nowrap}
.pill{
  display:inline-flex;align-items:center;gap:6px;font-family:var(--font-head);font-weight:700;
  font-size:.78rem;letter-spacing:.03em;padding:5px 11px;border-radius:999px;border:1px solid;
}
.pill--yes{background:#E9F3EE;border-color:#BFDCCC;color:#1F6B45}
.pill--no{background:#FBEDE9;border-color:#F0CFC4;color:#9C3D22}
.umlage .ref{display:block;font-size:.83rem;color:var(--muted);font-weight:400;margin-top:2px}

/* Nachweispaket */
.docs{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:760px){.docs{grid-template-columns:1fr}}
.docs li{
  background:#fff;border:1px solid var(--line);border-radius:var(--r-md);padding:18px 20px;
  display:flex;flex-direction:column;gap:5px;
}
.docs b{font-family:var(--font-head);font-size:1rem;color:var(--ink)}
.docs span{font-size:.9rem;color:var(--body)}
.docs em{font-style:normal;color:var(--brand-700);font-weight:600}

/* Hervorgehobener Rechtsblock */
.legal{
  background:var(--navy-800);color:#C6D6DA;border-radius:var(--r-xl);padding:clamp(28px,4vw,44px);
  display:flex;flex-direction:column;gap:16px;position:relative;overflow:hidden;
}
.legal::before{content:"";position:absolute;inset:0;background:radial-gradient(640px 300px at 88% 0%,rgba(217,164,65,.20),transparent 62%)}
.legal>*{position:relative}
.legal h2,.legal h3{color:#fff}
.legal .eyebrow{color:var(--brand-400)}
.legal .eyebrow::before{background:var(--brand-400)}
.legal p{margin:0;max-width:72ch}
.legal__cite{
  font-family:var(--font-head);font-size:.83rem;color:#8FA8AF;
  border-left:3px solid var(--brand-400);padding-left:14px;
}

/* ==========================================================================
   Projektgalerie
   ========================================================================== */
.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
@media(max-width:900px){.gallery{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.gallery{grid-template-columns:1fr}}
.shot{
  margin:0;background:#fff;border:1px solid var(--line);border-radius:var(--r-md);
  overflow:hidden;display:flex;flex-direction:column;
}
.shot img{
  width:100%;aspect-ratio:3/4;object-fit:cover;display:block;background:var(--bg-soft);
}
.shot figcaption{padding:13px 15px;font-size:.88rem;color:var(--body);display:flex;flex-direction:column;gap:3px}
.shot b{font-family:var(--font-head);font-size:.94rem;color:var(--ink);font-weight:600}
.shot small{font-size:.79rem;color:var(--muted)}

/* Zwei-Spalten-Leistungsblöcke */
.duo{display:grid;grid-template-columns:1fr 1fr;gap:22px}
@media(max-width:820px){.duo{grid-template-columns:1fr}}
.duo>div{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:28px}
.duo h3{margin-bottom:6px}
.duo>div>p:first-of-type{font-size:.93rem;color:var(--muted);margin-bottom:16px}

/* Abgrenzungsband */
.scope{
  display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--line);
  border-radius:var(--r-lg);overflow:hidden;background:#fff;
}
@media(max-width:760px){.scope{grid-template-columns:1fr}}
.scope>div{padding:26px}
.scope__we{border-right:1px solid var(--line)}
@media(max-width:760px){.scope__we{border-right:none;border-bottom:1px solid var(--line)}}
.scope__they{background:var(--bg-soft)}
.scope h3{font-size:1.02rem;margin-bottom:12px;display:flex;align-items:center;gap:9px}
.scope h3 span{
  font-family:var(--font-mono,var(--font-head));font-size:.68rem;font-weight:700;letter-spacing:.09em;
  text-transform:uppercase;padding:4px 9px;border-radius:4px;
}
.scope__we h3 span{background:var(--brand-500);color:var(--navy-900)}
.scope__they h3 span{background:var(--navy-700);color:#fff}
.scope ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px}
.scope li{font-size:.93rem;padding-left:18px;position:relative}
.scope li::before{content:"";position:absolute;left:0;top:.6em;width:6px;height:6px;border-radius:50%;background:var(--brand-500)}
.scope__they li::before{background:var(--navy-700)}

/* Sehr schmale Viewports: nur die Bildmarke, der Name steht im aria-label des Links */
@media(max-width:345px){
  .logo>span{position:absolute;left:-9999px}
  .logo__mark{height:32px}
}
